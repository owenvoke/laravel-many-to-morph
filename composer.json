{
    "name": "nevadskiy/laravel-many-to-morph",
    "description": "The missing polymorphic relationship for Eloquent.",
    "keywords": [
        "many-to-morph",
        "many-to-any",
        "relation",
        "laravel",
        "eloquent"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^10.0 || ^11.0"
    },
    "require-dev": {
		"phpunit/phpunit": "^11",
        "friendsofphp/php-cs-fixer": "^3.0"
	},
	"autoload": {
        "psr-4": {
            "Nevadskiy\\ManyToMorph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nevadskiy\\ManyToMorph\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
